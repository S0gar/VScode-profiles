{"name":"default","settings":"{\"settings\":\"{\\r\\n    \\\"github.copilot.enable\\\": {\\r\\n        \\\"*\\\": false,\\r\\n        \\\"plaintext\\\": false,\\r\\n        \\\"markdown\\\": false,\\r\\n        \\\"scminput\\\": false\\r\\n    },\\r\\n    // =========================================================================\\r\\n    // 1. ОПТИМИЗАЦИЯ ПРОИЗВОДИТЕЛЬНОСТИ И ПАМЯТИ (12 GB RAM Tweaks)\\r\\n    // =========================================================================\\r\\n    \\\"telemetry.telemetryLevel\\\": \\\"off\\\",\\r\\n    \\\"extensions.ignoreRecommendations\\\": true,\\r\\n    \\\"workbench.startupEditor\\\": \\\"none\\\",\\r\\n    \\\"editor.minimap.enabled\\\": false, // Экономит ресурсы GPU/RAM и место на экране 14\\\"\\r\\n    \\\"editor.renderWhitespace\\\": \\\"selection\\\",\\r\\n    \\\"editor.bracketPairColorization.enabled\\\": true,\\r\\n    \\\"editor.guides.bracketPairs\\\": \\\"active\\\",\\r\\n    \\\"editor.smoothScrolling\\\": true,\\r\\n    \\\"workbench.list.smoothScrolling\\\": true,\\r\\n    // Исключаем тяжелые директории из индексации и наблюдения (File Watcher)\\r\\n    \\\"files.watcherExclude\\\": {\\r\\n        \\\"**/.git/objects/**\\\": true,\\r\\n        \\\"**/.git/subtree-cache/**\\\": true,\\r\\n        \\\"**/node_modules/*/**\\\": true,\\r\\n        \\\"**/.venv/**\\\": true,\\r\\n        \\\"**/venv/**\\\": true,\\r\\n        \\\"**/env/**\\\": true,\\r\\n        \\\"**/__pycache__/**\\\": true,\\r\\n        \\\"**/.pytest_cache/**\\\": true,\\r\\n        \\\"**/.mypy_cache/**\\\": true,\\r\\n        \\\"**/.ruff_cache/**\\\": true,\\r\\n        \\\"**/build/**\\\": true,\\r\\n        \\\"**/cmake-build-*/**\\\": true\\r\\n    },\\r\\n    \\\"search.exclude\\\": {\\r\\n        \\\"**/node_modules\\\": true,\\r\\n        \\\"**/.venv\\\": true,\\r\\n        \\\"**/venv\\\": true,\\r\\n        \\\"**/__pycache__\\\": true,\\r\\n        \\\"**/.ruff_cache\\\": true,\\r\\n        \\\"**/build\\\": true,\\r\\n        \\\"**/cmake-build-*\\\": true,\\r\\n        \\\"**/*.sqlite\\\": true,\\r\\n        \\\"**/*.sqlite3\\\": true,\\r\\n        \\\"**/*.db\\\": true\\r\\n    },\\r\\n    // =========================================================================\\r\\n    // 2. ОБЩИЕ НАСТРОЙКИ РЕДАКТОРА И ФАЙЛОВ\\r\\n    // =========================================================================\\r\\n    \\\"files.autoSave\\\": \\\"onFocusChange\\\",\\r\\n    \\\"files.trimTrailingWhitespace\\\": true,\\r\\n    \\\"files.insertFinalNewline\\\": true,\\r\\n    \\\"editor.formatOnSave\\\": true,\\r\\n    \\\"editor.suggestSelection\\\": \\\"first\\\",\\r\\n    \\\"editor.InlineSuggest.enabled\\\": true, // Для подсказок Gemini на лету\\r\\n    \\\"editor.fontSize\\\": 14,\\r\\n    \\\"editor.tabSize\\\": 4,\\r\\n    \\\"editor.insertSpaces\\\": true,\\r\\n    // =========================================================================\\r\\n    // 3. PYTHON (Pylance + Ruff)\\r\\n    // =========================================================================\\r\\n    \\\"python.languageServer\\\": \\\"Pylance\\\",\\r\\n    \\\"python.analysis.typeCheckingMode\\\": \\\"basic\\\", // Баланс между строгостью и скоростью\\r\\n    \\\"python.analysis.autoImportCompletions\\\": true,\\r\\n    \\\"python.analysis.indexing\\\": true,\\r\\n    \\\"python.analysis.packageIndexDepths\\\": [\\r\\n        {\\r\\n            \\\"name\\\": \\\"fastapi\\\",\\r\\n            \\\"depth\\\": 2\\r\\n        },\\r\\n        {\\r\\n            \\\"name\\\": \\\"sqlalchemy\\\",\\r\\n            \\\"depth\\\": 2\\r\\n        },\\r\\n        {\\r\\n            \\\"name\\\": \\\"sklearn\\\",\\r\\n            \\\"depth\\\": 2\\r\\n        },\\r\\n        {\\r\\n            \\\"name\\\": \\\"pandas\\\",\\r\\n            \\\"depth\\\": 1\\r\\n        },\\r\\n        {\\r\\n            \\\"name\\\": \\\"numpy\\\",\\r\\n            \\\"depth\\\": 1\\r\\n        }\\r\\n    ],\\r\\n    \\\"python.terminal.activateEnvironment\\\": true,\\r\\n    \\\"[python]\\\": {\\r\\n        \\\"editor.defaultFormatter\\\": \\\"charliermarsh.ruff\\\",\\r\\n        \\\"editor.formatOnSave\\\": true,\\r\\n        \\\"editor.codeActionsOnSave\\\": {\\r\\n            \\\"source.fixAll.ruff\\\": \\\"explicit\\\",\\r\\n            \\\"source.organizeImports.ruff\\\": \\\"explicit\\\"\\r\\n        }\\r\\n    },\\r\\n    // Настройки для Jupyter-ноутбуков (ML)\\r\\n    \\\"notebook.formatOnSave.enabled\\\": true,\\r\\n    \\\"notebook.codeActionsOnSave\\\": {\\r\\n        \\\"notebook.source.fixAll\\\": \\\"explicit\\\",\\r\\n        \\\"notebook.source.organizeImports\\\": \\\"explicit\\\"\\r\\n    },\\r\\n    \\\"jupyter.askForKernelRestart\\\": false,\\r\\n    // =========================================================================\\r\\n    // 4. C++ (clangd + CMake)\\r\\n    // =========================================================================\\r\\n    // На всякий случай жестко отключаем движок Microsoft, если он вдруг подтянется\\r\\n    \\\"C_Cpp.intelliSenseEngine\\\": \\\"disabled\\\",\\r\\n    // Обязательно генерируем compile_commands.json для работы clangd\\r\\n    \\\"cmake.exportCompileCommandsFile\\\": true,\\r\\n    \\\"cmake.copyCompileCommands\\\": \\\"${workspaceFolder}/compile_commands.json\\\",\\r\\n    \\\"cmake.configureOnOpen\\\": true,\\r\\n    \\\"clangd.arguments\\\": [\\r\\n        \\\"--background-index\\\",\\r\\n        \\\"--compile-commands-dir=${workspaceFolder}\\\",\\r\\n        \\\"--clang-tidy\\\",\\r\\n        \\\"--completion-style=detailed\\\",\\r\\n        \\\"--header-insertion=iwyu\\\",\\r\\n        \\\"--pch-storage=memory\\\", // Хранит прекомпилированные заголовки в памяти (быстро и экономно для небольших проектов)\\r\\n        \\\"-j=4\\\" // Ограничиваем 4 потоками под i3-10105F, чтобы не вешать систему при индексации\\r\\n    ],\\r\\n    \\\"[cpp]\\\": {\\r\\n        \\\"editor.defaultFormatter\\\": \\\"llvm-vs-code-extensions.vscode-clangd\\\",\\r\\n        \\\"editor.formatOnSave\\\": true\\r\\n    },\\r\\n    \\\"[c]\\\": {\\r\\n        \\\"editor.defaultFormatter\\\": \\\"llvm-vs-code-extensions.vscode-clangd\\\",\\r\\n        \\\"editor.formatOnSave\\\": true\\r\\n    },\\r\\n    // =========================================================================\\r\\n    // 5. MARKDOWN (Obsidian-style)\\r\\n    // =========================================================================\\r\\n    \\\"[markdown]\\\": {\\r\\n        \\\"editor.wordWrap\\\": \\\"on\\\",\\r\\n        \\\"editor.quickSuggestions\\\": {\\r\\n            \\\"comments\\\": \\\"off\\\",\\r\\n            \\\"strings\\\": \\\"off\\\",\\r\\n            \\\"other\\\": \\\"on\\\"\\r\\n        },\\r\\n        \\\"files.trimTrailingWhitespace\\\": false // Чтобы не ломать переносы строк в MD (два пробела в конце)\\r\\n    },\\r\\n    // =========================================================================\\r\\n    // 6. ТЕРМИНАЛ И ГИТ (Fedora Linux + Windows)\\r\\n    // =========================================================================\\r\\n    \\\"terminal.integrated.scrollback\\\": 5000, // Ограничиваем буфер для экономии ОЗУ\\r\\n    \\\"terminal.integrated.enableMultiLinePasteWarning\\\": \\\"auto\\\",\\r\\n    \\\"terminal.integrated.defaultProfile.linux\\\": \\\"bash\\\", // Поменяй на \\\"zsh\\\", если используешь его\\r\\n    // На Windows удобно использовать Git Bash или WSL по умолчанию:\\r\\n    \\\"terminal.integrated.defaultProfile.windows\\\": \\\"Git Bash\\\",\\r\\n    \\\"git.autofetch\\\": false, // Отключаем фоновый опрос удаленных репозиториев\\r\\n    \\\"git.confirmSync\\\": false,\\r\\n    \\\"git.enableSmartCommit\\\": true,\\r\\n    \\\"diffEditor.ignoreTrimWhitespace\\\": false,\\r\\n    \\\"clangd.path\\\": \\\"c:\\\\\\\\Users\\\\\\\\ense\\\\\\\\AppData\\\\\\\\Roaming\\\\\\\\Code\\\\\\\\User\\\\\\\\globalStorage\\\\\\\\llvm-vs-code-extensions.vscode-clangd\\\\\\\\install\\\\\\\\23.1.0\\\\\\\\clangd_23.1.0\\\\\\\\bin\\\\\\\\clangd.exe\\\",\\r\\n    \\\"chat.disableAIFeatures\\\": true,\\r\\n    \\\"cmake.cmakePath\\\": \\\"C:\\\\\\\\Program Files\\\\\\\\CMake\\\\\\\\bin\\\\\\\\cmake.exe\\\",\\r\\n    \\\"workbench.iconTheme\\\": \\\"material-icon-theme\\\"\\r\\n}\\r\\n\"}","extensions":"[{\"identifier\":{\"id\":\"github.copilot-chat\"},\"displayName\":\"GitHub Copilot\",\"disabled\":true,\"applicationScoped\":false},{\"identifier\":{\"id\":\"aaron-bond.better-comments\",\"uuid\":\"7a0110bb-231a-4598-aa1b-0769ea46d28b\"},\"displayName\":\"Better Comments\",\"applicationScoped\":true},{\"identifier\":{\"id\":\"alefragnani.bookmarks\",\"uuid\":\"b689fcc8-d494-4dbf-a228-2c694a578afc\"},\"displayName\":\"Bookmarks\",\"applicationScoped\":true},{\"identifier\":{\"id\":\"alefragnani.project-manager\",\"uuid\":\"1b747f06-3789-4ebd-ac99-f1fe430c3347\"},\"displayName\":\"Project Manager\",\"applicationScoped\":true},{\"identifier\":{\"id\":\"fanaticpythoner.better-todo-tree\",\"uuid\":\"19c58f78-5ab3-45d0-8a95-51bc14a8cc42\"},\"displayName\":\"Better Todo Tree\",\"applicationScoped\":true},{\"identifier\":{\"id\":\"formulahendry.code-runner\",\"uuid\":\"a6a0c5b2-d078-4bf5-a9ee-4e37054414b3\"},\"displayName\":\"Code Runner\",\"applicationScoped\":true},{\"identifier\":{\"id\":\"ms-ceintl.vscode-language-pack-ru\",\"uuid\":\"392df454-688b-4d61-8dba-a12956ac6448\"},\"displayName\":\"Russian Language Pack for Visual Studio Code\",\"applicationScoped\":true},{\"identifier\":{\"id\":\"oderwat.indent-rainbow\",\"uuid\":\"eaa2127d-cb69-4ab9-8505-a60c9ee5f28b\"},\"applicationScoped\":true},{\"identifier\":{\"id\":\"pkief.material-icon-theme\",\"uuid\":\"5db78037-f674-459f-a236-db622c427c5b\"},\"displayName\":\"Material Icon Theme\",\"applicationScoped\":true},{\"identifier\":{\"id\":\"streetsidesoftware.code-spell-checker\",\"uuid\":\"f6dbd813-b0a0-42c1-90ea-10dde9d925a7\"},\"displayName\":\"Code Spell Checker\",\"applicationScoped\":true},{\"identifier\":{\"id\":\"stre